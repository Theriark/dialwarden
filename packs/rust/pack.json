{
  "id": "rust",
  "version": "1.0.0",
  "displayName": "Rust",
  "steamAppId": 258550,
  "builds": {
    "from": 0,
    "to": null
  },
  "os": ["linux", "windows"],
  "detection": {
    "markers": [
      {
        "path": "RustDedicated",
        "os": ["linux"]
      },
      {
        "path": "RustDedicated.exe",
        "os": ["windows"]
      }
    ]
  },
  "files": [
    {
      "id": "servercfg",
      "paths": {
        "linux": ["server/rustserver/cfg/server.cfg"],
        "windows": ["server/rustserver/cfg/server.cfg"]
      },
      "adapter": "cfg",
      "encoding": "utf-8",
      "applyPolicy": "anytime"
    },
    {
      "id": "userscfg",
      "paths": {
        "linux": ["server/rustserver/cfg/users.cfg"],
        "windows": ["server/rustserver/cfg/users.cfg"]
      },
      "adapter": "cfg",
      "encoding": "utf-8",
      "applyPolicy": "anytime"
    },
    {
      "id": "launch",
      "paths": {
        "linux": ["dialwarden-args.txt"],
        "windows": ["dialwarden-args.txt"]
      },
      "adapter": "launch",
      "encoding": "utf-8",
      "applyPolicy": "anytime",
      "launchSources": [
        {
          "kind": "args"
        }
      ]
    }
  ],
  "settings": [
    {
      "key": "server.description",
      "file": "servercfg",
      "locator": {
        "kind": "cfg",
        "command": "server.description"
      },
      "type": "string",
      "default": "",
      "max": 1024,
      "group": "Identity",
      "restartRequired": true,
      "panelManaged": true,
      "description": "Longer text shown on the server details screen. A literal backslash-n sequence inside the value becomes a line break there."
    },
    {
      "key": "server.url",
      "file": "servercfg",
      "locator": {
        "kind": "cfg",
        "command": "server.url"
      },
      "type": "string",
      "default": "",
      "max": 256,
      "group": "Identity",
      "restartRequired": true,
      "description": "Website link shown on the details screen, for example a community page or an invite to a chat server."
    },
    {
      "key": "server.headerimage",
      "file": "servercfg",
      "locator": {
        "kind": "cfg",
        "command": "server.headerimage"
      },
      "type": "string",
      "default": "",
      "max": 256,
      "group": "Identity",
      "restartRequired": true,
      "description": "Direct link to the banner image drawn on the server details screen. Community notes suggest a picture of 512 by 256 pixels."
    },
    {
      "key": "server.logoimage",
      "file": "servercfg",
      "locator": {
        "kind": "cfg",
        "command": "server.logoimage"
