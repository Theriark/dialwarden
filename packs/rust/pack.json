      "group": "World",
      "restartRequired": true,
      "description": "Extra generation value that, with seed and size, rebuilds an exact earlier map. Usually left unset."
    },
    {
      "key": "server.worldsize",
      "file": "launch",
      "locator": {
        "kind": "launch",
        "flag": "+server.worldsize"
      },
      "type": "int",
      "default": 3000,
      "min": 1000,
      "max": 6000,
      "unit": "metres",
      "group": "World",
      "restartRequired": true,
      "panelManaged": true,
      "description": "Edge length of the map. Bigger maps cost more memory and CPU, and a change starts a new world file."
    },
    {
      "key": "server.tickrate",
      "file": "launch",
      "locator": {
        "kind": "launch",
        "flag": "+server.tickrate"
      },
      "type": "int",
      "default": 30,
      "min": 15,
      "max": 100,
      "unit": "Hz",
      "group": "Performance",
      "restartRequired": true,
      "description": "Server simulation updates per second. Higher values cost more CPU and feel more responsive."
    },
    {
      "key": "rcon.port",
      "file": "launch",
      "locator": {
        "kind": "launch",
        "flag": "+rcon.port"
      },
      "type": "int",
      "default": 28016,
      "min": 1024,
      "max": 65535,
      "unit": "port",
      "group": "Remote console",
      "restartRequired": true,
      "panelManaged": true,
      "description": "TCP port for the remote console. Dialwarden uses it for saves, announcements and clean shutdowns."
    },
    {
      "key": "rcon.password",
      "file": "launch",
      "locator": {
        "kind": "launch",
        "flag": "+rcon.password"
      },
      "type": "string",
      "group": "Remote console",
      "restartRequired": true,
      "secret": true,
      "panelManaged": true,
      "description": "Secret needed for remote console access. Empty or short values on a public port allow a takeover."
    },
    {
      "key": "rcon.web",
      "file": "launch",
      "locator": {
        "kind": "launch",
        "flag": "+rcon.web"
      },
      "type": "bool",
      "default": true,
      "group": "Remote console",
      "restartRequired": true,
      "description": "Uses the websocket remote console when on, or the older Source-style protocol when off. Dialwarden needs it on."
    },
    {
      "key": "rcon.ip",
      "file": "launch",
      "locator": {
        "kind": "launch",
        "flag": "+rcon.ip"
      },
      "type": "string",
      "default": "0.0.0.0",
      "group": "Remote console",
      "restartRequired": true,
      "description": "Local address the remote console binds to. 127.0.0.1 keeps it reachable only from the host."
    },
    {
      "key": "batchmode",
      "file": "launch",
      "locator": {
        "kind": "launch",
        "flag": "-batchmode"
      },
      "type": "bool",
      "group": "Launch",
      "restartRequired": true,
      "description": "Runs the server headless without a window. Every known start script includes it."
    },
    {
      "key": "logfile",
      "file": "launch",
      "locator": {
        "kind": "launch",
        "flag": "-logfile"
      },
      "type": "string",
      "group": "Launch",
      "restartRequired": true,
      "description": "File that receives the server log. Without it the output goes to the standard output."
    }
  ],
  "rules": [
    {
      "id": "rcon-web-weak-password",
      "severity": "error",
      "settings": ["rcon.password"],
      "message": "Web remote console is on but its password is missing or shorter than 12 characters. Anyone who reaches the port can control the server.",
      "when": {
        "and": [
          {
            "==": [
              {
                "var": "rcon.web"
              },
              true
            ]
          },
          {
            "<": [
              {
                "strlen": [
                  {
                    "var": "rcon.password"
                  }
                ]
              },
              12
            ]
          }
        ]
      },
      "serverEvaluated": true
    },
    {
      "id": "port-collision",
      "severity": "error",
      "settings": ["server.port", "server.queryport", "rcon.port", "app.port"],
      "message": "Two services share a port. Game, query, remote console and companion app ports must all differ.",
      "when": {
        "or": [
          {
            "==": [
              {
                "var": "server.port"
              },
              {
                "var": "rcon.port"
              }
            ]
          },
          {
            "==": [
              {
                "var": "server.port"
              },
              {
                "var": "server.queryport"
              }
            ]
          },
          {
            "==": [
              {
                "var": "server.port"
              },
              {
                "var": "app.port"
              }
            ]
          },
          {
            "==": [
              {
                "var": "rcon.port"
              },
              {
                "var": "server.queryport"
              }
            ]
          },
          {
            "==": [
              {
                "var": "rcon.port"
              },
              {
                "var": "app.port"
              }
            ]
          },
          {
            "==": [
              {
                "var": "server.queryport"
              },
              {
                "var": "app.port"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "worldsize-large",
      "severity": "warning",
      "settings": ["server.worldsize"],
      "message": "Maps above 4500 metres need a lot of memory and CPU on most hosts.",
      "when": {
        ">": [
          {
            "var": "server.worldsize"
          },
          4500
        ]
      }
    },
    {
      "id": "negative-on-launch",
      "severity": "error",
      "settings": ["app.port"],
      "message": "Launch arguments cannot carry negative numbers, so -1 becomes 1 here. Put the negative value in server.cfg instead.",
      "when": {
        "<": [
          {
            "var": "app.port"
          },
          0
        ]
      }
    },
    {
      "id": "rcon-web-off",
      "severity": "warning",
      "settings": ["rcon.web"],
      "message": "Legacy remote console is selected. The Dialwarden save, announce and clean-stop actions need web remote console.",
      "when": {
        "==": [
          {
            "var": "rcon.web"
          },
          false
        ]
      }
    },
    {
      "id": "decay-zero-info",
      "severity": "info",
      "settings": ["decay.scale"],
      "message": "Decay scale 0 stops all building decay, so the upkeep settings have no visible effect.",
      "when": {
        "==": [
          {
            "var": "decay.scale"
          },
          0
        ]
      }
    },
    {
      "id": "queryport-unset",
      "severity": "warning",
      "settings": ["server.queryport"],
      "message": "No query port is set. Set one explicitly so browser queries do not clash with other instances.",
      "when": {
        "!": {
          "var": "server.queryport"
        }
      }
    }
  ],
  "presets": [
    {
      "id": "vanilla-default",
      "label": "Vanilla defaults",
      "description": "The shipped ruleset and economy: normal decay, vanilla mode and the stock spawn rates.",
      "values": {
        "server.gamemode": "vanilla",
        "server.pve": false,
        "decay.scale": 1,
        "decay.upkeep": true,
        "decay.upkeep_period_minutes": 1440,
        "decay.upkeep_grief_protection": 1440,
        "craft.instant": false,
        "relationshipmanager.maxteamsize": 8,
        "hackablelockedcrate.requiredhackseconds": 900,
        "spawn.min_rate": 0.5,
        "spawn.max_rate": 1,
        "spawn.min_density": 0.5,
        "spawn.max_density": 1,
        "server.corpsedespawn": 300,
        "chat.globalchat": true
      }
    },
    {
      "id": "casual-low-decay",
      "label": "Casual, low decay",
      "description": "Slower decay with longer upkeep cycles, faster respawns and a longer corpse timer for relaxed communities.",
      "values": {
        "decay.scale": 0.25,
        "decay.upkeep": true,
        "decay.upkeep_period_minutes": 2880,
        "decay.upkeep_grief_protection": 2880,
        "decay.duration_twig": 2,
        "decay.duration_wood": 8,
        "hackablelockedcrate.requiredhackseconds": 300,
        "spawn.min_rate": 1,
        "spawn.min_density": 1,
        "server.corpsedespawn": 1800,
        "server.itemdespawn": 600,
        "craft.instant": false
      }
    },
    {
      "id": "hardcore",
      "label": "Hardcore",
      "description": "Faster decay, smaller teams, no global chat and scarcer loot, closer to the old hardcore rules.",
      "values": {
        "server.gamemode": "hardcore",
        "decay.scale": 1.5,
        "decay.upkeep_period_minutes": 720,
        "decay.upkeep_grief_protection": 360,
        "relationshipmanager.maxteamsize": 3,
        "chat.globalchat": false,
        "chat.localchat": true,
        "spawn.min_rate": 0.5,
        "spawn.max_rate": 0.8,
        "server.corpsedespawn": 300,
        "hackablelockedcrate.requiredhackseconds": 900
      }
    }
  ],
  "probes": [
    {
      "kind": "rustWebRcon",
      "portSetting": "rcon.port",
      "passwordSetting": "rcon.password",
      "host": "127.0.0.1",
      "allow": ["server.save", "quit"],
      "saveCommand": "server.save",
      "stopCommand": "quit"
    },
    {
      "kind": "a2s",
      "portSetting": "server.queryport",
      "host": "127.0.0.1",
      "players": true
    }
  ],
  "hooksSupported": ["save", "stop"],
  "sources": [
    "https://github.com/GameServerManagers/LinuxGSM/blob/master/lgsm/config-default/config-lgsm/rustserver/_default.cfg",
    "https://github.com/GameServerManagers/Game-Server-Configs/blob/master/rust/server.cfg",
    "https://github.com/didstopia/rust-server",
    "https://github.com/physk/rust-dedicated-server-docker/blob/master/docker/fullvars.txt",
    "https://github.com/OxideMod/Oxide.Docs/blob/main/docs/guides/owners/setup-server.md",
    "https://github.com/Bad3r/rust-server/blob/main/CLAUDE.md",
    "https://github.com/RustWipeDay/RustWipeDay/blob/main/server.cfg",
    "https://github.com/netwarlan/server-configs/blob/main/rust/users.cfg",
    "https://github.com/Facepunch/webrcon"
  ]
}
