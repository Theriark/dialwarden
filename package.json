{
  "name": "dialwarden",
  "version": "27.0.0",
  "private": true,
  "description": "Dialwarden: self-hosted settings editor for SteamCMD-installed dedicated game servers. Free and Paid plans in one image.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "packs:check": "vitest run packs/packs.test.ts packages/packs-schema/src/packs-check.test.ts",
    "build": "pnpm -r run build && pnpm run check:assets && pnpm run check:bundle",
    "check:assets": "node tools/notices/src/check-assets.mjs apps/web/dist",
    "check:bundle": "node tools/licence/src/check-bundle.mjs",
    "notices": "node tools/notices/src/notices.mjs THIRD_PARTY_NOTICES",
    "licence:audit": "node tools/notices/src/audit.mjs docs/licences.md"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^24.0.10",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9.30.0",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^16.3.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "better-sqlite3"
    ],
    "auditConfig": {
      "ignoreGhsas": []
    }
  }
}
